{
  "name": "odyssey-main-manage-front-vue3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "i18n:extract": "voerkai18n extract",
    "posti18n:extract": "npm run i18n:normalize",
    "i18n:normalize": "node scripts/normalize-i18n-dictionary.mjs",
    "i18n:compile": "voerkai18n compile",
    "predev": "npm run i18n:compile",
    "dev": "vite",
    "predev:demo": "npm run i18n:compile",
    "dev:demo": "vite --mode demo",
    "prebuild": "npm run i18n:compile",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run i18n:compile",
    "test": "node --test tests/*.test.mjs",
    "translate": "npm run i18n:extract && voerkai18n translate --api chatgpt && npm run i18n:normalize && npm run i18n:compile",
    "compile": "voerkai18n compile"
  },
  "dependencies": {
    "@voerkai18n/runtime": "3.0.22",
    "@voerkai18n/vue": "3.0.22",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "element-plus": "2.14.3",
    "pinia": "3.0.3",
    "vue": "3.5.45",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.2",
    "@voerkai18n/cli": "3.1.0",
    "vite": "7.3.8"
  }
}
