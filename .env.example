# Copy to .env.development.local for a local real-API session.
# Gateway origin. This flag is server-side only.
PHOENIX_BACKEND_TARGET=
# Optional OAuth client header for the dev reverse proxy. Keep it server-side.
PHOENIX_LOGIN_AUTHORIZATION=

# Existing backend routes, relative to the same origin by default.
VITE_MAIN_API_BASE=/api
VITE_INSTANT_API_BASE=/api/instant/api
VITE_INSTANT_COUNTRY_CODE=ng
# Optional fixed gateway language. Leave empty to send the selected UI language.
VITE_API_LANGUAGE=
# Legacy protocol inputs. VITE_ values are visible in the browser bundle.
VITE_LEGACY_LOGIN_KEY=
VITE_LEGACY_LOGIN_IV=
